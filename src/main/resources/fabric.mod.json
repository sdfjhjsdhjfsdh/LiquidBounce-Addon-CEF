{
  "schemaVersion": 1,
  "id": "liquidflame-cef",
  "version": "${version}",
  "name": "LiquidFlame CEF",
  "description": "Shows the client's menus with Chromium, through the Chromium Embedded Framework. LiquidFlame comes with it.",
  "authors": [
    "CCBlueX"
  ],
  "contact": {
    "homepage": "https://liquidflame.net/",
    "sources": "https://github.com/CCBlueX/LiquidFlame-Addon-CEF",
    "issues": "https://github.com/CCBlueX/LiquidFlame-Addon-CEF/issues"
  },
  "license": "LGPL-2.1-or-later",
  "environment": "client",
  "entrypoints": {
    "liquidflame": [
      "net.liquidflame.liquidflame.cef.CefAddon"
    ]
  },
  "mixins": [
    "liquidflame-cef.mixins.json"
  ],
  "accessWidener": "liquidflame-cef.accesswidener",
  "depends": {
    "minecraft": "~${minecraft_version}",
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "liquidflame": "*"
  },
  "custom": {
    "liquidflame": {
      "color": "#4285F4"
    },
    "modmenu": {
      "parent": "liquidflame"
    }
  }
}
